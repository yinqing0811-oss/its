# Copy this file to .env or set these variables in your shell.
#
# DeepSeek real LLM mode:
# export DEEPSEEK_API_KEY="your_deepseek_api_key_here"
# export DEEPSEEK_MODEL="deepseek-v4-flash"
# export DEEPSEEK_BASE_URL="https://api.deepseek.com"
#
# Local demo/evaluation mode:
# export LLM_PROVIDER="mock"

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
DEEPSEEK_REASONING_EFFORT=high
LLM_PROVIDER=deepseek
ITS_ALLOW_MOCK_LLM=1
LLM_TEMPERATURE=0.3

# Optional OpenAI-compatible fallback. Keep these empty unless you switch
# LLM_PROVIDER to openai or another OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
